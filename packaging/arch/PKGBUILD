# Maintainer: Siverteh <92440237+Siverteh@users.noreply.github.com>
pkgname=nacre-niri
pkgver=26.04.r2795.gf1dea218
pkgrel=1
pkgdesc='Nacre-compatible Niri compositor, installable beside stock niri'
arch=('x86_64')
url='https://github.com/nacre-desktop/nacre-niri'
license=('GPL-3.0-or-later')
# Build the checkout containing this recipe, or explicitly select an immutable revision.
# Run from packaging/arch; standalone recipe copies must provide _commit.
_commit=${_commit:-$(git -C "$startdir/../.." rev-parse --verify HEAD)}
[[ $_commit =~ ^[0-9a-f]{40}$ ]] || return 1
source=("nacre-niri::git+https://github.com/nacre-desktop/nacre-niri.git#commit=${_commit}"
        'nacre-niri-session' 'nacre-niri.desktop')
sha256sums=('SKIP'
            '4de600073d9d6f3edcff521abd8c82ef40378387722d030f876370da2226527c'
            '33b55bfedc42a061818b329f75aea93113da8501574ca033bc5c1f2298ff036e')
# Keep stock niri available for rollback; systemd owns the fallback units and Bash runs the wrapper.
depends=('niri>=26.04' 'systemd' 'bash' 'cairo' 'glib2' 'glibc' 'libdisplay-info' 'libgcc' 'libinput' 'libpipewire' 'libxkbcommon' 'mesa' 'pango' 'pixman' 'seatd' 'systemd-libs')
makedepends=('git' 'rust' 'cargo' 'clang' 'cmake' 'ninja' 'pkgconf' 'wayland-protocols')
optdepends=('xwayland-satellite: run X11 applications')
backup=()
options=('!lto')

pkgver() {
  cd "$srcdir/nacre-niri"
  printf '26.04.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$srcdir/nacre-niri"
  source_rev=$(git rev-parse HEAD)
  if [[ "$source_rev" != "$_commit" ]]; then
    printf 'Source revision mismatch: %s (expected %s)\n' "$source_rev" "$_commit" >&2
    return 1
  fi
}

build() {
  cd "$srcdir/nacre-niri"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR="$srcdir/target"
  export NIRI_BUILD_VERSION_STRING="26.04 (nacre-niri ${_commit})"
  nice -n 10 cargo build --release --locked -j2
}

package() {
  cd "$srcdir/nacre-niri"
  install -Dm755 "$srcdir/target/release/niri" "$pkgdir/usr/bin/nacre-niri"
  install -Dm755 "$srcdir/nacre-niri-session" "$pkgdir/usr/bin/nacre-niri-session"
  install -Dm644 "$srcdir/nacre-niri.desktop" "$pkgdir/usr/share/wayland-sessions/nacre-niri.desktop"
  install -Dm644 resources/niri.service "$pkgdir/usr/lib/systemd/user/nacre-niri.service"
  install -Dm644 resources/niri-shutdown.target "$pkgdir/usr/lib/systemd/user/nacre-niri-shutdown.target"
  sed -i 's/^Description=.*/Description=Shutdown running nacre-niri session/' "$pkgdir/usr/lib/systemd/user/nacre-niri-shutdown.target"
  sed -i 's/ExecStart=niri --session/ExecStart=\/usr\/bin\/nacre-niri --session/' "$pkgdir/usr/lib/systemd/user/nacre-niri.service"
}
